{{ form_start(form) }}
    {% do form.interests.setRendered %}

    {# ---- Photo ---- #}
    <div class="mb-5">
        {{ form_label(form.photo) }}
        <div class="flex items-center gap-4">
            {% if profile.photoFilename %}
                <img src="{{ asset('uploads/profiles/' ~ profile.photoFilename) }}" alt="Aktualne zdjęcie" class="h-16 w-16 flex-none rounded-xl object-cover ring-1 ring-slate-200">
            {% else %}
                <span class="grid h-16 w-16 flex-none place-items-center rounded-xl bg-slate-100 text-slate-400">
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.964 0a9 9 0 10-11.964 0m11.964 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </span>
            {% endif %}
            <div class="min-w-0 flex-1">
                {{ form_widget(form.photo) }}
                {{ form_errors(form.photo) }}
                <p class="mt-1.5 text-xs text-slate-400">JPG, PNG lub WebP, maksymalnie 2&nbsp;MB.</p>
            </div>
        </div>
    </div>

    {{ form_widget(form) }}

    {# ---- Interests (dynamic collection) ---- #}
    <div class="mb-5"
         data-controller="form-collection"
         data-form-collection-index-value="{{ form.interests|length }}"
         data-form-collection-prototype-value="{{ form_widget(form.interests.vars.prototype.name)|e('html_attr') }}">
        <span class="field-label">Zainteresowania</span>
        <div data-form-collection-target="entries" class="space-y-2">
            {% for interest in form.interests %}
                <div class="flex items-center gap-2" data-form-collection-target="entry">
                    <div class="flex-1">{{ form_widget(interest.name) }}</div>
                    <button type="button" data-action="form-collection#remove" class="icon-btn flex-none text-slate-400 hover:bg-red-50 hover:text-red-600" aria-label="Usuń">
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
                    </button>
                </div>
            {% endfor %}
        </div>
        <button type="button" data-action="form-collection#add" class="btn-ghost btn-sm mt-3">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/></svg>
            Dodaj zainteresowanie
        </button>
    </div>

    <div class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-6">
        <button type="submit" class="btn-primary">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            {{ button_label|default('Zapisz') }}
        </button>
        <a href="{{ path('app_home') }}" class="btn-ghost">Anuluj</a>
    </div>
{{ form_end(form) }}

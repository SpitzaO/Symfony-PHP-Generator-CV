{% extends 'base.html.twig' %}

{% block title %}Edytuj profil{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl space-y-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Edytuj profil</h1>
                <p class="mt-1 text-sm text-slate-500">{{ profile.firstName }} {{ profile.lastName }}</p>
            </div>
            {{ include('_delete_form.html.twig', {delete_path: 'app_profile_delete', id: profile.id}) }}
        </div>

        <div class="card p-6 sm:p-8">
            {{ include('profile/_form.html.twig', {'button_label': 'Zaktualizuj'}) }}
        </div>
    </div>
{% endblock %}

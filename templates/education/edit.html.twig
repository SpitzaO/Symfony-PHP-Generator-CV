{% extends 'base.html.twig' %}

{% block title %}Edit Education{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl space-y-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Edit education</h1>
                <p class="mt-1 text-sm text-slate-500">{{ education.schoolName }}</p>
            </div>
            {{ include('_delete_form.html.twig', {delete_path: 'app_education_delete', id: education.id}) }}
        </div>
        <div class="card p-6 sm:p-8">
            {{ include('education/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>
{% endblock %}

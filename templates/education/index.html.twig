{% extends 'base.html.twig' %}

{% block title %}Wykształcenie{% endblock %}

{% block body %}
    <div class="space-y-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Wykształcenie</h1>
                <p class="mt-1 text-sm text-slate-500">Liczba pozycji: {{ education|length }}</p>
            </div>
            <a href="{{ path('app_education_new') }}" class="btn-primary self-start sm:self-auto">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                Nowe wykształcenie
            </a>
        </div>

        {% if education|length > 0 %}
            <div class="card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50/80">
                            <tr>
                                <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Szkoła</th>
                                <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Kierunek</th>
                                <th class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Okres</th>
                                <th class="px-6 py-3.5 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Akcje</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                        {% for education in education %}
                            <tr class="transition hover:bg-slate-50/70">
                                <td class="px-6 py-4 font-medium text-slate-900">
                                    <div>{{ education.schoolName }}</div>
                                    {% if education.location %}<div class="mt-0.5 text-xs font-normal text-slate-400">{{ education.location }}</div>{% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    {% if education.degree %}<span class="badge-blue">{{ education.degree }}</span>{% else %}<span class="text-slate-400">—</span>{% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                    {{ education.startDate ? education.startDate|date('m.Y') : '—' }} &ndash; {{ education.endDate ? education.endDate|date('m.Y') : 'Obecnie' }}
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-1">
                                        <a href="{{ path('app_education_show', {'id': education.id}) }}" class="icon-btn" title="Zobacz" aria-label="Zobacz">
                                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" /><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg>
                                        </a>
                                        <a href="{{ path('app_education_edit', {'id': education.id}) }}" class="icon-btn" title="Edytuj" aria-label="Edytuj">
                                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="card flex flex-col items-center px-6 py-16 text-center">
                <div class="grid h-14 w-14 place-items-center rounded-xl bg-blue-50 text-blue-600">
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>
                </div>
                <h3 class="mt-4 text-base font-semibold text-slate-900">Brak wykształcenia</h3>
                <p class="mt-1 text-sm text-slate-500">Dodaj szkoły, kierunki i okresy nauki.</p>
                <a href="{{ path('app_education_new') }}" class="btn-primary mt-6">Dodaj wykształcenie</a>
            </div>
        {% endif %}
    </div>
{% endblock %}

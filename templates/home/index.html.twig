{% extends 'base.html.twig' %}

{% block title %}{{ profile ? profile.firstName ~ ' ' ~ profile.lastName ~ ' · CV' : 'CV' }}{% endblock %}

{% block body %}
    {% if profile %}
        {% set initials = (profile.firstName|first ~ profile.lastName|first)|upper %}

        {% if is_granted('ROLE_ADMIN') %}
            <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-blue-50 px-4 py-3 text-sm ring-1 ring-inset ring-blue-200">
                <span class="inline-flex items-center gap-1.5 font-semibold text-blue-800">
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.661 2.237a.531.531 0 01.678 0 11.947 11.947 0 007.078 2.749.5.5 0 01.479.425c.069.52.104 1.05.104 1.59 0 5.162-3.26 9.563-7.834 11.256a.48.48 0 01-.332 0C4.939 16.564 1.68 12.163 1.68 7c0-.538.035-1.069.104-1.589a.5.5 0 01.48-.425 11.947 11.947 0 007.397-2.75z" clip-rule="evenodd" /></svg>
                    Tryb administratora
                </span>
                <a href="{{ path('app_profile_edit', {'id': profile.id}) }}" class="font-medium text-blue-700 transition hover:text-blue-900">Edytuj profil</a>
                <a href="{{ path('app_experience_new') }}" class="font-medium text-blue-700 transition hover:text-blue-900">+ Doświadczenie</a>
                <a href="{{ path('app_education_new') }}" class="font-medium text-blue-700 transition hover:text-blue-900">+ Wykształcenie</a>
                <a href="{{ path('app_skill_new') }}" class="font-medium text-blue-700 transition hover:text-blue-900">+ Umiejętność</a>
                <a href="{{ path('app_competency_new') }}" class="font-medium text-blue-700 transition hover:text-blue-900">+ Kompetencja</a>
                <a href="{{ path('app_interest_new') }}" class="font-medium text-blue-700 transition hover:text-blue-900">+ Zainteresowanie</a>
                <a href="{{ path('app_competency_index') }}" class="font-medium text-blue-700 transition hover:text-blue-900">Kompetencje</a>
                <a href="{{ path('app_cv_pdf') }}" target="_blank" class="font-medium text-blue-700 transition hover:text-blue-900">Eksportuj PDF</a>
                <a href="{{ path('app_logout') }}" class="ml-auto inline-flex items-center gap-1 font-medium text-blue-700 transition hover:text-blue-900">
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd" /><path fill-rule="evenodd" d="M6 10a.75.75 0 01.75-.75h9.546l-1.048-.943a.75.75 0 111.004-1.114l2.5 2.25a.75.75 0 010 1.114l-2.5 2.25a.75.75 0 11-1.004-1.114l1.048-.943H6.75A.75.75 0 016 10z" clip-rule="evenodd" /></svg>
                    Wyloguj
                </a>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            {# ============ LEFT: contact, skills, competencies, interests ============ #}
            <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
                <section class="card overflow-hidden">
                    <div class="h-24 bg-gradient-to-r from-blue-600 via-cyan-600 to-teal-600"></div>
                    <div class="-mt-12 px-6 pb-6">
                        {% if profile.photoFilename %}
                            <img src="{{ asset('uploads/profiles/' ~ profile.photoFilename) }}" alt="{{ profile.firstName }} {{ profile.lastName }}" class="h-24 w-24 rounded-2xl object-cover shadow-md ring-4 ring-white">
                        {% else %}
                            <div class="grid h-24 w-24 place-items-center rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-600 text-3xl font-bold text-white shadow-md ring-4 ring-white">
                                {{ initials }}
                            </div>
                        {% endif %}
                        <h1 class="mt-4 text-xl font-bold tracking-tight text-slate-900">{{ profile.firstName }} {{ profile.lastName }}</h1>

                        <ul class="mt-5 space-y-2.5 text-sm">
                            <li class="flex items-center gap-2.5 text-slate-600">
                                <svg class="h-4 w-4 flex-none text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 4a2 2 0 00-2 2v.01l9 5.4 9-5.4V6a2 2 0 00-2-2H3z" /><path d="M19 8.118l-9 5.4-9-5.4V14a2 2 0 002 2h14a2 2 0 002-2V8.118z" /></svg>
                                <a href="mailto:{{ profile.email }}" class="truncate transition hover:text-blue-600">{{ profile.email }}</a>
                            </li>
                            <li class="flex items-center gap-2.5 text-slate-600">
                                <svg class="h-4 w-4 flex-none text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5z" clip-rule="evenodd" /></svg>
                                <a href="tel:{{ profile.phone }}" class="transition hover:text-blue-600">{{ profile.phone }}</a>
                            </li>
                            {% if profile.githubUrl %}
                                <li class="flex items-center gap-2.5 text-slate-600">
                                    <svg class="h-4 w-4 flex-none text-slate-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                                    <a href="{{ profile.githubUrl }}" target="_blank" rel="noopener noreferrer" class="truncate transition hover:text-blue-600">{{ profile.githubUrl|replace({'https://': '', 'http://': ''}) }}</a>
                                </li>
                            {% endif %}
                            {% if profile.websiteUrl %}
                                <li class="flex items-center gap-2.5 text-slate-600">
                                    <svg class="h-4 w-4 flex-none text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><ellipse cx="10" cy="10" rx="3.2" ry="7.5"/><line x1="2.5" y1="10" x2="17.5" y2="10"/></svg>
                                    <a href="{{ profile.websiteUrl }}" target="_blank" rel="noopener noreferrer" class="truncate transition hover:text-blue-600">{{ profile.websiteUrl|replace({'https://': '', 'http://': ''}) }}</a>
                                </li>
                            {% endif %}
                            {% if profile.birthDate %}
                                <li class="flex items-center gap-2.5 text-slate-600">
                                    <svg class="h-4 w-4 flex-none text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" /></svg>
                                    {{ profile.birthDate|date('d.m.Y') }}
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </section>

                <section class="card p-6">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                            <span class="h-1.5 w-1.5 rounded-full bg-lime-500"></span> Umiejętności
                        </h2>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_skill_new') }}" class="text-xs font-medium text-blue-600 hover:text-blue-500">+ Dodaj</a>
                        {% endif %}
                    </div>
                    {% if profile.skills|length > 0 %}
                        <ul class="mt-4 space-y-2.5">
                            {% for skill in profile.skills %}
                                <li class="flex items-center justify-between gap-3">
                                    <span class="text-sm font-medium text-slate-700">{{ skill.name }}</span>
                                    <span class="badge-emerald">{{ skill.level }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="mt-3 text-sm text-slate-400">Nie dodano jeszcze umiejętności.</p>
                    {% endif %}
                </section>

                {% if profile.competencies|length > 0 %}
                    <section class="card p-6">
                        <div class="flex items-center justify-between gap-2">
                            <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> Kompetencje
                            </h2>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_competency_index') }}" class="text-xs font-medium text-blue-600 hover:text-blue-500">Zarządzaj</a>
                            {% endif %}
                        </div>
                        <div class="mt-4 space-y-4">
                            {% for competency in profile.competencies %}
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-800">{{ competency.name }}</h3>
                                    {% if competency.items|length > 0 %}
                                        <ul class="mt-2 space-y-2 border-l-2 border-slate-100 pl-3">
                                            {% for item in competency.items %}
                                                <li>
                                                    <p class="text-sm font-medium text-slate-700">{{ item.name }}</p>
                                                    {% if item.description %}
                                                        <p class="mt-0.5 text-xs leading-relaxed text-slate-500">{{ item.description }}</p>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        <p class="mt-1 text-xs text-slate-400">Brak pozycji.</p>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {% if profile.interests|length > 0 or is_granted('ROLE_ADMIN') %}
                    <section class="card p-6">
                        <div class="flex items-center justify-between gap-2">
                            <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                <span class="h-1.5 w-1.5 rounded-full bg-orange-600"></span> Zainteresowania
                            </h2>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_interest_index') }}" class="text-xs font-medium text-blue-600 hover:text-blue-500">Zarządzaj</a>
                            {% endif %}
                        </div>
                        {% if profile.interests|length > 0 %}
                            <div class="mt-4 flex flex-wrap gap-2">
                                {% for interest in profile.interests %}
                                    <span class="badge-slate">{{ interest.name }}</span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="mt-3 text-sm text-slate-400">Nie dodano jeszcze zainteresowań.</p>
                        {% endif %}
                    </section>
                {% endif %}
            </aside>

            {# ============ RIGHT: about, experience, education ============ #}
            <div class="space-y-8 lg:col-span-2">
                {% if profile.about %}
                    <section class="card p-6 sm:p-8">
                        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                            <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span> O mnie
                        </h2>
                        <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-slate-700">{{ profile.about }}</p>
                    </section>
                {% endif %}

                <section class="card p-6 sm:p-8">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                            <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span> Doświadczenie
                        </h2>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_experience_new') }}" class="text-sm font-medium text-blue-600 hover:text-blue-500">+ Dodaj</a>
                        {% endif %}
                    </div>

                    {% if profile.experiences|length > 0 %}
                        <ol class="mt-6 space-y-6 border-l border-slate-200 pl-6">
                            {% for experience in profile.experiences %}
                                <li class="relative">
                                    <span class="absolute -left-[1.9rem] top-1 grid h-4 w-4 place-items-center rounded-full bg-white ring-2 ring-cyan-500">
                                        <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
                                    </span>
                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                                        <h3 class="font-semibold text-slate-900">{{ experience.position }}</h3>
                                        <span class="text-xs font-medium text-slate-400">
                                            {{ experience.startDate ? experience.startDate|date('m.Y') : '—' }} &ndash; {{ experience.endDate ? experience.endDate|date('m.Y') : 'Obecnie' }}
                                        </span>
                                    </div>
                                    <p class="text-sm font-medium text-blue-600">{{ experience.company }}</p>
                                    {% if experience.location %}
                                        <p class="mt-0.5 flex items-center gap-1 text-xs text-slate-400">
                                            <svg class="h-3.5 w-3.5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" /></svg>
                                            {{ experience.location }}
                                        </p>
                                    {% endif %}
                                    {% if experience.description %}
                                        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-600">{{ experience.description }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">Nie dodano jeszcze doświadczenia.</p>
                    {% endif %}
                </section>

                <section class="card p-6 sm:p-8">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                            <span class="h-1.5 w-1.5 rounded-full bg-green-600"></span> Wykształcenie
                        </h2>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_education_new') }}" class="text-sm font-medium text-blue-600 hover:text-blue-500">+ Dodaj</a>
                        {% endif %}
                    </div>

                    {% if profile.education|length > 0 %}
                        <ol class="mt-6 space-y-6 border-l border-slate-200 pl-6">
                            {% for education in profile.education %}
                                <li class="relative">
                                    <span class="absolute -left-[1.9rem] top-1 grid h-4 w-4 place-items-center rounded-full bg-white ring-2 ring-green-600">
                                        <span class="h-1.5 w-1.5 rounded-full bg-green-600"></span>
                                    </span>
                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                                        <h3 class="font-semibold text-slate-900">{{ education.schoolName }}</h3>
                                        <span class="text-xs font-medium text-slate-400">
                                            {{ education.startDate ? education.startDate|date('m.Y') : '—' }} &ndash; {{ education.endDate ? education.endDate|date('m.Y') : 'Obecnie' }}
                                        </span>
                                    </div>
                                    {% if education.degree %}
                                        <p class="text-sm font-medium text-green-700">{{ education.degree }}</p>
                                    {% endif %}
                                    {% if education.location %}
                                        <p class="mt-0.5 flex items-center gap-1 text-xs text-slate-400">
                                            <svg class="h-3.5 w-3.5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" /></svg>
                                            {{ education.location }}
                                        </p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">Nie dodano jeszcze wykształcenia.</p>
                    {% endif %}
                </section>
            </div>
        </div>
    {% else %}
        {# ============ No profile yet ============ #}
        <div class="mx-auto flex max-w-lg flex-col items-center py-12 text-center sm:py-20">
            <div class="grid h-20 w-20 place-items-center rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-600 text-white shadow-lg shadow-blue-600/30">
                <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.964 0a9 9 0 10-11.964 0m11.964 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <h1 class="mt-6 text-2xl font-bold tracking-tight text-slate-900">Zbudujmy Twoje CV</h1>
                <p class="mt-2 text-slate-500">Nie ma jeszcze profilu. Utwórz go, aby rozpocząć swoje CV.</p>
                <a href="{{ path('app_profile_new') }}" class="btn-primary mt-8">
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                    Utwórz profil
                </a>
                <a href="{{ path('app_logout') }}" class="mt-4 text-sm font-medium text-slate-400 transition hover:text-slate-700">Wyloguj się</a>
            {% else %}
                <h1 class="mt-6 text-2xl font-bold tracking-tight text-slate-900">CV już wkrótce</h1>
                <p class="mt-2 text-slate-500">To CV nie zostało jeszcze opublikowane. Zajrzyj później.</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

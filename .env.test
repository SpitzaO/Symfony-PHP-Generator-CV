# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# SQLite keeps the suite self-contained — no MySQL needed to run or to build in CI.
# The schema is built from the entity mapping by DatabaseTestCase, not from migrations.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Throwaway credentials for the test firewall: "test-password", hashed at bcrypt cost 4
# to match the reduced cost configured in security.yaml under when@test.
ADMIN_PASSWORD_HASH='$2y$04$SkQklRS32Db9j39gJFp0J.DxMYONYVCsSEZmqNoeLEqynB3/8Yn9O'
